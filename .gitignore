# Zig's caches and outputs normally live in ~/zailc-work (cmem/best-practices.md); these catch a
# build run without --cache-dir.
.zig-cache/
zig-out/
*.o
# The tools' type-check installs into a copy in ~/zailc-work (tools/dev/typecheck.ts); this catches
# an install run in the checkout itself.
node_modules/
